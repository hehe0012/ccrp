{
  "ssh": {
    "host": "my-server",
    "connect_timeout": 10,
    "server_alive_interval": 30,
    "server_alive_count_max": 3
  },
  "server_proxy": {
    "listen": "127.0.0.1:8080",
    "upstream_timeout": 300
  },
  "routes": [
    {
      "name": "cc-switch",
      "local": "127.0.0.1:3456",
      "remote_forward": "127.0.0.1:18080",
      "path_prefix": "/",
      "strip_path_prefix": false,
      "target_path_prefix": "",
      "preserve_host": false
    }
  ]
}
